# Environment Variables for RooCheck
# Copy this file to .env.local and fill in your values

# Next.js automatically loads .env.local
# Never commit .env.local to version control

# Application URL (for production)
# NEXT_PUBLIC_APP_URL=https://roocheck.com

# API Configuration (future use)
# API_BASE_URL=http://localhost:3000/api

# Database Configuration (future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/roocheck
# DATABASE_SSL=false

# Authentication (future use)
# NEXTAUTH_SECRET=your-secret-key-here
# NEXTAUTH_URL=http://localhost:3000

# Analytics (future use)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Feature Flags (future use)
# ENABLE_USER_AUTH=false
# ENABLE_ADMIN_PANEL=false
# ENABLE_MULTILINGUAL=false

# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# All other variables are server-side only
